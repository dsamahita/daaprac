#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    float arr[] = {0.42, 0.32, 0.23, 0.52};
    int n=4;

    vector<float> bucket[10];

    for(int i=0;i<n;i++)
        bucket[int(arr[i]*10)].push_back(arr[i]);

    for(int i=0;i<10;i++)
        sort(bucket[i].begin(), bucket[i].end());

    for(int i=0;i<10;i++)
        for(float x:bucket[i]) cout<<x<<" ";
}
