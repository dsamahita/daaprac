#include <iostream>
using namespace std;

int main() {
    int graph[5][5] = {
        {0,10,0,5,0},
        {0,0,1,2,0},
        {0,0,0,0,4},
        {0,3,9,0,2},
        {7,0,6,0,0}
    };

    int dist[5]={0,999,999,999,999};
    bool visited[5]={0};

    for(int i=0;i<5;i++) {
        int u=-1,min=999;
        for(int j=0;j<5;j++)
            if(!visited[j] && dist[j]<min)
                min=dist[j],u=j;

        visited[u]=1;

        for(int v=0;v<5;v++)
            if(graph[u][v] && dist[u]+graph[u][v]<dist[v])
                dist[v]=dist[u]+graph[u][v];
    }

    for(int i=0;i<5;i++)
        cout<<"Dist to "<<i<<" = "<<dist[i]<<"\n";
}
