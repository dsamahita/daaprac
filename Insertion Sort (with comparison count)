#include <iostream>
using namespace std;

int insertionSort(int arr[], int n) {
    int comparisons = 0;

    for (int i = 1; i < n; i++) {
        int key = arr[i];
        int j = i - 1;

        while (j >= 0 && (++comparisons && arr[j] > key)) {
            arr[j + 1] = arr[j];
            j--;
        }
        arr[j + 1] = key;
    }
    return comparisons;
}

int main() {
    int n = 5, arr[] = {5, 3, 4, 1, 2};

    int comp = insertionSort(arr, n);

    cout << "Sorted: ";
    for(int i=0;i<n;i++) cout << arr[i] << " ";
    cout << "\nComparisons: " << comp;
}
