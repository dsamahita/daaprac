#include <iostream>
using namespace std;

int merge(int arr[], int l, int m, int r) {
    int i=l, j=m+1, k=0, temp[100], comp=0;

    while(i<=m && j<=r) {
        comp++;
        if(arr[i] <= arr[j]) temp[k++] = arr[i++];
        else temp[k++] = arr[j++];
    }

    while(i<=m) temp[k++] = arr[i++];
    while(j<=r) temp[k++] = arr[j++];

    for(int p=0;p<k;p++) arr[l+p]=temp[p];

    return comp;
}

int mergeSort(int arr[], int l, int r) {
    int comp=0;
    if(l<r) {
        int m=(l+r)/2;
        comp += mergeSort(arr,l,m);
        comp += mergeSort(arr,m+1,r);
        comp += merge(arr,l,m,r);
    }
    return comp;
}

int main() {
    int arr[]={5,2,4,1,3}, n=5;
    int comp = mergeSort(arr,0,n-1);

    cout<<"Sorted: ";
    for(int i=0;i<n;i++) cout<<arr[i]<<" ";
    cout<<"\nComparisons: "<<comp;
}
