#include <iostream>
using namespace std;

int main() {
    int graph[5][5] = {
        {0,2,0,6,0},
        {2,0,3,8,5},
        {0,3,0,0,7},
        {6,8,0,0,9},
        {0,5,7,9,0}
    };

    int selected[5]={0};
    selected[0]=1;

    for(int e=0;e<4;e++) {
        int min=999,x=0,y=0;

        for(int i=0;i<5;i++)
            if(selected[i])
                for(int j=0;j<5;j++)
                    if(!selected[j] && graph[i][j] && graph[i][j]<min) {
                        min=graph[i][j];
                        x=i;y=j;
                    }

        cout<<x<<"-"<<y<<" : "<<min<<"\n";
        selected[y]=1;
    }
}
