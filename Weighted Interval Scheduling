#include <iostream>
#include <algorithm>
using namespace std;

struct Job {
    int start, finish, profit;
};

// Sort by finish time
bool compare(Job a, Job b) {
    return a.finish < b.finish;
}

// Binary search to find last non-conflicting job
int latestNonConflict(Job jobs[], int i) {
    for (int j = i - 1; j >= 0; j--) {
        if (jobs[j].finish <= jobs[i].start)
            return j;
    }
    return -1;
}

int weightedIntervalScheduling(Job jobs[], int n) {
    sort(jobs, jobs + n, compare);

    int dp[100];
    dp[0] = jobs[0].profit;

    for (int i = 1; i < n; i++) {
        int includeProfit = jobs[i].profit;

        int l = latestNonConflict(jobs, i);
        if (l != -1)
            includeProfit += dp[l];

        dp[i] = max(includeProfit, dp[i - 1]);
    }

    return dp[n - 1];
}

int main() {
    Job jobs[] = {
        {1, 3, 50},
        {2, 5, 20},
        {4, 6, 70},
        {6, 7, 60},
        {5, 8, 30},
        {7, 9, 40}
    };

    int n = sizeof(jobs) / sizeof(jobs[0]);

    cout << "Maximum Profit: " 
         << weightedIntervalScheduling(jobs, n);

    return 0;
}
